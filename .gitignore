# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase CLI temporary state
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
encoding-check.cjs

# Archivos de referencia del usuario: pueden contener costos reales de la empresa.
# NUNCA deben subirse al repositorio.
/Archivos referencia/

# Documentos de cliente (tablas salariales, APU, propuestas). Todo lo que este
# en public/ se sirve por web: si un Excel de cliente llegara al repositorio,
# cualquiera podria descargarlo desde el sitio.
/public/*.xlsx
/public/*.xls
/public/*.pdf
/public/*.docx
/public/*.zip

# Verificaciones y artefactos locales
/encoding-check.cjs
/tsconfig.tsbuildinfo

# Servidor de desarrollo y artefactos locales de esta sesion
/dev*.log
/local-home-preview*.log
/tmp-*.png
/vlc-help.txt
/.tmp-salary-tables/
tmp-dev.log
